# Testnet environment
# Copy to .env.testnet and fill in values.
#
# Chain config, signer definitions, and endpoints live in
# config/environments/testnet.json.
#
# Generate keystores first (prompts for passphrase interactively):
#   cargo xtask generate-signer --name deployer --name operator-1 --name operator-2 --name operator-3
#   cargo xtask generate-signer --name signer-1 --name signer-2 --name signer-3

# ═══════════════════════════════════════════════════════════════════════════════
# Signer Passphrases (per-signer)
# ═══════════════════════════════════════════════════════════════════════════════
DEPLOYER_PASSPHRASE=<your-deployer-passphrase>
OPERATOR_1_PASSPHRASE=<your-operator-1-passphrase>
OPERATOR_2_PASSPHRASE=<your-operator-2-passphrase>
OPERATOR_3_PASSPHRASE=<your-operator-3-passphrase>

# ═══════════════════════════════════════════════════════════════════════════════
# RPC URLs
# ═══════════════════════════════════════════════════════════════════════════════
SOURCE_RPC_URL=<your-source-chain-rpc-url>
DEST_RPC_URL=<your-destination-chain-rpc-url>

# ═══════════════════════════════════════════════════════════════════════════════
# Service Secrets
# ═══════════════════════════════════════════════════════════════════════════════
WEBHOOK_SECRET=<generate-a-32-char-secret>
OZ_RELAYER_API_KEY=<generate-a-32-char-api-key>
OZ_RELAYER_WEBHOOK_SECRET=<generate-a-32-char-secret>
# Used by OZ Relayer container to decrypt relayer keystores at runtime
KEYSTORE_PASSPHRASE=<your-relayer-keystore-passphrase>

# ═══════════════════════════════════════════════════════════════════════════════
# Optional Overrides (advanced)
# ═══════════════════════════════════════════════════════════════════════════════
# Override the key used for relay genesis (defaults to deployer signer key)
# GENESIS_PRIVATE_KEY=0x...
