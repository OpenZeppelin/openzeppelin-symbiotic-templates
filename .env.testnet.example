# Testnet environment
# Copy to .env.testnet and fill in values.
# Chain config (chain IDs, endpoints) lives in config/environments/testnet.json.

# ═══════════════════════════════════════════════════════════════════════════════
# Deployer Key
# ═══════════════════════════════════════════════════════════════════════════════
# Funds operators and deploys contracts. Must have ETH on both chains.
PRIVATE_KEY=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# Operator Private Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Each operator has its own EVM private key, also used as BLS key seed.
# Must be funded with >= 0.01 ETH on the settlement chain.
OPERATOR_COUNT=3
OPERATOR_1_PRIVATE_KEY=0x...
OPERATOR_2_PRIVATE_KEY=0x...
OPERATOR_3_PRIVATE_KEY=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# OZ Relayer Signer Keys (optional — separate from operator keys)
# ═══════════════════════════════════════════════════════════════════════════════
# If not set, run `cargo xtask bootstrap-relayer-signers` to generate keystores.
# RELAYER_1_PRIVATE_KEY=0x...
# RELAYER_2_PRIVATE_KEY=0x...
# RELAYER_3_PRIVATE_KEY=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# Service Secrets
# ═══════════════════════════════════════════════════════════════════════════════
WEBHOOK_URL=http://operator:3000/webhook/events
WEBHOOK_SECRET=<generate-a-32-char-secret>
OZ_RELAYER_API_KEY=<generate-a-32-char-api-key>
OZ_RELAYER_WEBHOOK_SECRET=<generate-a-32-char-secret>
KEYSTORE_PASSPHRASE=<your-keystore-passphrase>

# ═══════════════════════════════════════════════════════════════════════════════
# Timing
# ═══════════════════════════════════════════════════════════════════════════════
EPOCH_DURATION=60
SLASHING_WINDOW=60
