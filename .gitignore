# Foundry
cache/
out/
broadcast/

# Message tracking cache
.cache/

# Dependencies
node_modules/

# Anvil PID file
.anvil.pid

data/

# Contract deployment artifacts
contracts/deploy-data/
contracts/.tmp/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
target/
bin/
dist/

# Database files
*.db
*.log

# Environment files — ignore any .env or .env.<anything>, except .env.local (committed Anvil template) and *.example
.env
.env.*
!.env.example
!.env.*.example
!.env.local

# Generated runtime/config state
generated/

# Local deployment state
deployments/local.json

# Mainnet env + deployments are operator-owned, not part of the template
config/environments/mainnet.json
deployments/mainnet.json

# IDE
.vscode/
.idea/
.serena/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Internal development docs
devdocs/

# Keystore files (encrypted private keys) — any depth under a `keys/` dir
**/keys/**/*.json

# Temporary contract config files
contracts/.tmp-*.json

# Deployment backups
deployments/*.backup.json
