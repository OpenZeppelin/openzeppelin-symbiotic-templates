#!/usr/bin/env bash
# Unified devnet message testing tool
#
# Provider selection is loaded from config/root.config.json (active_provider).
# Supported providers:
#   - layerzero: real TestOApp send + DVN verification watch
#   - chainlink_ccv: mock CCIPMessageSent webhook injection + operator signing watch

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

# Global flags
VERBOSE=false
DRY_RUN=false
JSON_OUTPUT=false
TIMEOUT=120
MESSAGE="hello"
GUID=""
TX_HASH=""
ACTIVE_PROVIDER=""

CCV_EVENT_SIGNATURE="CCIPMessageSent(uint64,address,bytes32,address,uint256,bytes,(address,uint32,uint32,uint256,bytes)[],bytes[])"
CCV_VERSION_TAG="${CCV_VERSION_TAG:-0x1a75bd93}"

show_help() {
    cat <<'USAGE'
msg - Devnet message testing tool

USAGE:
    msg <command> [options]

COMMANDS:
    send      Send a test message
    status    One-shot status check across all operators
    watch     Poll operators until message is verified/signed
    e2e       Combined send + watch

OPTIONS:
    -m, --message <text>   Message content (default: "hello")
    -g, --guid <id>        Message ID to check/watch
    -t, --tx <hash>        Source TX hash to find message
    --timeout <seconds>    Max wait time for watch/e2e (default: 120)
    -v, --verbose          Show streaming logs
    --dry-run              Print commands without executing
    --json                 Machine-readable output
    -h, --help             Show this help

PROVIDER:
    Provider is loaded from config/root.config.json -> active_provider.
    This script intentionally does not accept --provider.

EXAMPLES:
    msg send
    msg send -m "hello world"
    msg watch --timeout 180
    msg e2e -v
USAGE
}

load_dotenv_if_present() {
    if [[ -f "$PROJECT_ROOT/.env" ]]; then
        set -a
        # shellcheck disable=SC1091
        source "$PROJECT_ROOT/.env"
        set +a
    fi
}

load_runtime_context() {
    load_addresses || true
    load_dotenv_if_present

    ACTIVE_PROVIDER="$(get_active_provider)"

    case "$ACTIVE_PROVIDER" in
        layerzero|chainlink_ccv)
            ;;
        *)
            die "unsupported active_provider '$ACTIVE_PROVIDER' in $ROOT_CONFIG_FILE"
            ;;
    esac

    ensure_provider_alignment "$ACTIVE_PROVIDER"
}

topic_for_u64() {
    local value="$1"
    printf '0x%064x' "$value"
}

topic_for_address() {
    local address_hex="${1#0x}"
    if [[ ${#address_hex} -ne 40 ]]; then
        die "invalid address for topic encoding: $1"
    fi
    echo "0x000000000000000000000000${address_hex}"
}

hmac_signature_hex() {
    local body="$1"
    local timestamp_ms="$2"

    if ! command -v openssl >/dev/null 2>&1; then
        die "openssl is required to sign webhook payloads"
    fi
    if [[ -z "${WEBHOOK_SECRET:-}" ]]; then
        die "WEBHOOK_SECRET is required to post mock webhook events"
    fi

    printf '%s%s' "$body" "$timestamp_ms" \
        | openssl dgst -sha256 -hmac "$WEBHOOK_SECRET" -hex \
        | awk '{print $NF}'
}

post_provider_webhook() {
    local port="$1"
    local body="$2"

    local timestamp_ms
    timestamp_ms=$(( $(date +%s%N) / 1000000 ))

    local signature
    signature="$(hmac_signature_hex "$body" "$timestamp_ms")"

    curl -sf -X POST "http://localhost:${port}/webhook/events" \
        -H "Content-Type: application/json" \
        -H "X-Timestamp: ${timestamp_ms}" \
        -H "X-Signature: ${signature}" \
        -d "$body" >/dev/null
}

load_watch_target_from_cache() {
    if [[ -n "$GUID" || -n "$TX_HASH" ]]; then
        return 0
    fi

    if [[ ! -f "$CACHE_FILE" ]]; then
        die "no message to watch. Run 'msg send' first or specify --guid/--tx"
    fi

    GUID="$(jq -r 'if .guid == null then "" else .guid end' "$CACHE_FILE" 2>/dev/null || true)"
    TX_HASH="$(jq -r '.tx_hash // empty' "$CACHE_FILE" 2>/dev/null || true)"

    if [[ -z "$GUID" && -z "$TX_HASH" ]]; then
        die "no message to watch. Run 'msg send' first or specify --guid/--tx"
    fi

    if ! $JSON_OUTPUT; then
        local msg
        msg="$(jq -r '.message // empty' "$CACHE_FILE" 2>/dev/null || true)"
        [[ -n "$msg" ]] && echo "Watching last message: \"$msg\""
        [[ -n "$TX_HASH" ]] && echo "TX: $TX_HASH"
        [[ -n "$GUID" ]] && echo "Message ID: $GUID"
        echo ""
    fi
}

cmd_send_layerzero() {
    load_addresses || true

    local testoapp
    testoapp=$(get_testoapp_address 2>/dev/null) || testoapp="\$TEST_OAPP_SOURCE_ADDRESS"

    local gas_limit="${GAS:-200000}"

    if $DRY_RUN; then
        echo "# Build executor options"
        echo "OPTIONS=\$(cast call $testoapp \"buildOptions(uint128)(bytes)\" $gas_limit --rpc-url $SOURCE_RPC)"
        echo ""
        echo "# Quote messaging fee"
        echo "QUOTE=\$(cast call $testoapp \"quote(uint32,string,bytes,bool)((uint256,uint256))\" $DEST_EID \"$MESSAGE\" \"\$OPTIONS\" false --rpc-url $SOURCE_RPC)"
        echo ""
        echo "# Send the message"
        echo "cast send $testoapp \"send(uint32,string,bytes)\" $DEST_EID \"$MESSAGE\" \"\$OPTIONS\" --value <fee> --rpc-url $SOURCE_RPC --private-key $PRIVATE_KEY --json"
        return 0
    fi

    if [[ "$testoapp" == "\$TEST_OAPP_SOURCE_ADDRESS" ]]; then
        die "no TestOApp address. Run 'make start' first"
    fi

    if ! $JSON_OUTPUT; then
        echo "Provider: layerzero"
        echo "Sending message: \"$MESSAGE\""
        echo "To EID: $DEST_EID"
        echo ""
    fi

    local options
    options=$(cast call "$testoapp" "buildOptions(uint128)(bytes)" "$gas_limit" --rpc-url "$SOURCE_RPC")

    local quote_result fee
    quote_result=$(cast call "$testoapp" "quote(uint32,string,bytes,bool)((uint256,uint256))" "$DEST_EID" "$MESSAGE" "$options" false --rpc-url "$SOURCE_RPC")
    fee=$(echo "$quote_result" | tr -d '()' | cut -d',' -f1 | tr -d ' ' | cut -d'[' -f1)

    if ! [[ "$fee" =~ ^[0-9]+$ ]] || [[ "$fee" == "0" ]]; then
        fee="1000000000000000"
    fi

    local tx_json tx_hash block_hex block
    tx_json=$(cast send "$testoapp" \
        "send(uint32,string,bytes)" \
        "$DEST_EID" \
        "$MESSAGE" \
        "$options" \
        --value "$fee" \
        --rpc-url "$SOURCE_RPC" \
        --private-key "$PRIVATE_KEY" \
        --json)

    tx_hash=$(echo "$tx_json" | jq -r '.transactionHash')
    block_hex=$(echo "$tx_json" | jq -r '.blockNumber')
    block=$((block_hex))

    save_to_cache "$tx_hash" "$block" "" "$MESSAGE" "$DEST_EID"

    if $JSON_OUTPUT; then
        echo "{\"provider\":\"layerzero\",\"tx_hash\":\"$tx_hash\",\"block\":$block}"
    else
        echo "TX: $tx_hash"
        echo "Block: $block"
        echo ""
        echo "Track with: make watch"
    fi
}

cmd_send_chainlink_ccv() {
    load_addresses || true

    local onramp
    onramp="$(get_ccv_source_onramp_address 2>/dev/null || true)"
    if [[ -z "$onramp" ]]; then
        die "unable to resolve CCV source onRamp address. Set providers.chainlink_ccv.source_onramp_address and run make configure"
    fi

    local dest_selector
    dest_selector="$(get_ccv_dest_chain_selector)"

    local sender
    sender="$(cast wallet address --private-key "$PRIVATE_KEY" 2>/dev/null || echo "0x0000000000000000000000000000000000000000")"

    local nonce
    nonce="$(date +%s%N)"

    local message_id
    message_id="$(cast keccak "ccv-message:${MESSAGE}:${nonce}:${sender}")"

    local tx_hash
    tx_hash="$(cast keccak "ccv-tx:${message_id}:${nonce}")"

    local block_number
    block_number="$(cast block-number --rpc-url "$SOURCE_RPC" 2>/dev/null || echo "0")"

    local block_hash
    block_hash="$(cast keccak "ccv-block:${block_number}:${tx_hash}")"

    local topic0 topic1 topic2 topic3
    topic0="$(cast keccak "$CCV_EVENT_SIGNATURE")"
    topic1="$(topic_for_u64 "$dest_selector")"
    topic2="$(topic_for_address "$sender")"
    topic3="$message_id"

    local encoded_message
    encoded_message="$(cast abi-encode "f(string)" "$MESSAGE")"

    local log_data
    log_data="$(cast abi-encode "f(address,uint256,bytes,(address,uint32,uint32,uint256,bytes)[],bytes[])" \
        "0x0000000000000000000000000000000000000000" \
        0 \
        "$encoded_message" \
        "[]" \
        "[$CCV_VERSION_TAG]")"

    local source_chain_id
    source_chain_id="${SOURCE_CHAIN_ID:-31337}"

    local payload
    payload="$(jq -n \
        --arg onramp "$onramp" \
        --arg topic0 "$topic0" \
        --arg topic1 "$topic1" \
        --arg topic2 "$topic2" \
        --arg topic3 "$topic3" \
        --arg log_data "$log_data" \
        --arg tx_hash "$tx_hash" \
        --arg sender "$sender" \
        --arg block_hash "$block_hash" \
        --arg signature "$CCV_EVENT_SIGNATURE" \
        --arg monitor_name "chainlink_ccv_ccip_message_sent_monitor" \
        --argjson block_number "$block_number" \
        --argjson chain_id "$source_chain_id" \
        '{
          EVM: {
            logs: [
              {
                address: $onramp,
                topics: [$topic0, $topic1, $topic2, $topic3],
                data: $log_data,
                blockNumber: $block_number,
                transactionHash: $tx_hash,
                logIndex: 0
              }
            ],
            matched_on_args: {
              events: [
                {
                  args: [],
                  hex_signature: $topic0,
                  signature: $signature
                }
              ]
            },
            monitor: {
              name: $monitor_name
            },
            network_slug: "local_anvil",
            receipt: null,
            transaction: {
              blockHash: $block_hash,
              blockNumber: $block_number,
              transactionIndex: 0,
              from: $sender,
              to: $onramp,
              hash: $tx_hash,
              chainId: $chain_id
            }
          }
        }')"

    if $DRY_RUN; then
        echo "# CCV send uses webhook injection (mock OnRamp event)"
        echo "curl -X POST http://localhost:3001/webhook/events ..."
        echo ""
        echo "$payload" | jq .
        return 0
    fi

    if ! $JSON_OUTPUT; then
        echo "Provider: chainlink_ccv"
        echo "Injecting synthetic CCIPMessageSent webhook event"
        echo "Message ID: $message_id"
        echo "Source OnRamp: $onramp"
        echo "Dest selector: $dest_selector"
    fi

    for port in "${OPERATOR_PORTS[@]}"; do
        post_provider_webhook "$port" "$payload"
        if $VERBOSE && ! $JSON_OUTPUT; then
            echo "Posted webhook to operator on :$port"
        fi
    done

    save_to_cache "$tx_hash" "$block_number" "$message_id" "$MESSAGE" "$dest_selector"

    if $JSON_OUTPUT; then
        echo "{\"provider\":\"chainlink_ccv\",\"mode\":\"mock_webhook\",\"message_id\":\"$message_id\",\"tx_hash\":\"$tx_hash\"}"
    else
        echo ""
        echo "Synthetic CCV event submitted. Track with:"
        echo "  make watch"
    fi
}

cmd_send() {
    case "$ACTIVE_PROVIDER" in
        layerzero) cmd_send_layerzero ;;
        chainlink_ccv) cmd_send_chainlink_ccv ;;
        *) die "unsupported active provider: $ACTIVE_PROVIDER" ;;
    esac
}

cmd_status() {
    if [[ -z "$GUID" && -z "$TX_HASH" && -f "$CACHE_FILE" ]]; then
        GUID=$(jq -r 'if .guid == null then "" else .guid end' "$CACHE_FILE" 2>/dev/null || true)
        TX_HASH=$(jq -r '.tx_hash // empty' "$CACHE_FILE" 2>/dev/null || true)
        if ! $JSON_OUTPUT; then
            local msg
            msg=$(jq -r '.message // empty' "$CACHE_FILE" 2>/dev/null || true)
            [[ -n "$msg" ]] && echo "Last message: \"$msg\""
            [[ -n "$TX_HASH" ]] && echo "TX: $TX_HASH"
            echo ""
        fi
    fi

    if $DRY_RUN; then
        echo "# Query all operators"
        for port in "${OPERATOR_PORTS[@]}"; do
            echo "curl -s http://localhost:$port/debug/v1/messages?limit=50"
        done
        return 0
    fi

    if $JSON_OUTPUT; then
        local results="[]"
        for i in 1 2 3; do
            local port=$((3000 + i))
            local response
            response=$(query_operator "$port" "$GUID" "$TX_HASH")
            if [[ "$response" != "{}" && -n "$response" && "$response" != "null" ]]; then
                results=$(echo "$results" | jq --argjson data "$response" --argjson operator "$i" '. + [{operator:$operator,data:$data}]')
            fi
        done
        echo "$results"
        return 0
    fi

    echo "Provider: $ACTIVE_PROVIDER"
    echo "Operator Status"
    echo "═══════════════════════════════════════════════════════════════════"

    for i in 1 2 3; do
        local port=$((3000 + i))
        local response
        response=$(query_operator "$port" "$GUID" "$TX_HASH")

        echo ""
        echo "operator-$i (port $port):"

        if [[ -z "$response" || "$response" == "{}" || "$response" == "null" ]]; then
            echo "  Status: No message found"
            continue
        fi

        local msg_id status src_chain dst_chain sub_state sub_tx
        msg_id=$(echo "$response" | jq -r '.metadata.message_id // "?"' 2>/dev/null)
        status=$(echo "$response" | jq -r '.status // "?"' 2>/dev/null)
        src_chain=$(echo "$response" | jq -r '.metadata.source_chain // "?"' 2>/dev/null)
        dst_chain=$(echo "$response" | jq -r '.metadata.destination_chain // "?"' 2>/dev/null)
        sub_state=$(echo "$response" | jq -r '.submission.state // "Pending"' 2>/dev/null)
        sub_tx=$(echo "$response" | jq -r '.submission.tx_hash // empty' 2>/dev/null)

        echo "  Message ID: ${msg_id:0:20}..."
        echo "  Route: $src_chain -> $dst_chain"
        echo "  Status: $status"
        echo "  Submission: $sub_state"
        [[ -n "$sub_tx" && "$sub_tx" != "null" ]] && echo "  Dest TX: $sub_tx"
    done

    echo ""
    echo "═══════════════════════════════════════════════════════════════════"
    echo "Pending Merkle Roots"
    echo "═══════════════════════════════════════════════════════════════════"

    local pending_count
    pending_count=$(curl -sf "http://localhost:3001/debug/v1/pending" 2>/dev/null | jq 'length' 2>/dev/null || echo "0")
    if [[ "$pending_count" == "0" || "$pending_count" == "null" ]]; then
        echo "None (all signatures collected)"
    else
        echo "$pending_count pending root(s) awaiting signatures"
    fi
}

cmd_watch_layerzero() {
    load_addresses || true

    local dvn_dest
    dvn_dest=$(get_dvn_dest_address 2>/dev/null) || dvn_dest="\$DVN_DEST_ADDRESS"

    if $DRY_RUN; then
        echo "# Poll operators for status and destination DVN logs"
        echo "curl -s http://localhost:3001/debug/v1/messages?limit=50"
        echo "cast logs --from-block <start> --address $dvn_dest --rpc-url $DEST_RPC"
        return 0
    fi

    load_watch_target_from_cache

    if ! $JSON_OUTPUT; then
        echo "═══════════════════════════════════════════════════════════════════"
        echo "Watching LayerZero message (timeout: ${TIMEOUT}s)"
        echo "═══════════════════════════════════════════════════════════════════"
        echo ""
    fi

    local start_time last_status dvn_verified dvn_tx_hash start_block
    start_time=$(date +%s)
    last_status=""
    dvn_verified=false
    dvn_tx_hash=""
    start_block=$(cast block-number --rpc-url "$DEST_RPC" 2>/dev/null || echo "0")

    while true; do
        local elapsed=$(( $(date +%s) - start_time ))
        if [[ $elapsed -ge $TIMEOUT ]]; then
            $JSON_OUTPUT && echo "{\"status\":\"timeout\",\"elapsed\":$elapsed}" || echo "Timeout after ${TIMEOUT}s"
            exit 1
        fi

        local best_status="" best_submission="" tx_hash_dest="" found_guid=""

        for i in 1 2 3; do
            local port=$((3000 + i))
            local response
            response=$(query_operator "$port" "$GUID" "$TX_HASH")

            if [[ "$response" != "{}" && -n "$response" && "$response" != "null" ]]; then
                if [[ -z "$GUID" || "$GUID" == "null" ]]; then
                    found_guid=$(echo "$response" | jq -r '.metadata.message_id // empty' 2>/dev/null || true)
                    [[ -n "$found_guid" && "$found_guid" != "null" ]] && GUID="$found_guid"
                fi

                local status submission_state submission_tx
                status=$(echo "$response" | jq -r '.status // "?"' 2>/dev/null || echo "?")
                submission_state=$(echo "$response" | jq -r '.submission.state // "Pending"' 2>/dev/null || echo "Pending")
                submission_tx=$(echo "$response" | jq -r '.submission.tx_hash // empty' 2>/dev/null || true)

                case $status in
                    Signed)
                        best_status="Signed"
                        best_submission="$submission_state"
                        tx_hash_dest="$submission_tx"
                        ;;
                    Processing) [[ "$best_status" != "Signed" ]] && best_status="Processing" ;;
                    Pending) [[ -z "$best_status" ]] && best_status="Pending" ;;
                    *) [[ -z "$best_status" ]] && best_status="$status" ;;
                esac
            fi
        done

        if [[ "$dvn_verified" == "false" && -n "$dvn_dest" ]]; then
            if check_dvn_verified "$dvn_dest" "$start_block"; then
                dvn_verified=true
                dvn_tx_hash=$(get_dvn_tx_hash "$dvn_dest" "$start_block")
            fi
        fi

        local current_status="${best_status}:${best_submission}:${dvn_verified}"
        if [[ "$current_status" != "$last_status" ]] && ! $JSON_OUTPUT; then
            local timestamp prev_status prev_submission prev_dvn
            timestamp=$(date +%H:%M:%S)
            IFS=':' read -r prev_status prev_submission prev_dvn <<< "$last_status"

            if [[ -n "$GUID" && "$last_status" == "" ]]; then
                echo "[$timestamp] Message ID: $GUID"
            fi
            [[ "$best_status" != "$prev_status" && -n "$best_status" ]] && echo "[$timestamp] $(format_status "$best_status")"
            if [[ "$best_submission" != "$prev_submission" && -n "$best_submission" && "$best_submission" != "Pending" ]]; then
                echo "[$timestamp] $(format_relayer_status "$best_submission" "$tx_hash_dest")"
            fi
            if [[ "$dvn_verified" == "true" && "$prev_dvn" != "true" ]]; then
                local dvn_msg="DVN: verified on destination"
                [[ -n "$dvn_tx_hash" ]] && dvn_msg="$dvn_msg (tx: $dvn_tx_hash)"
                echo "[$timestamp] $dvn_msg"
            fi

            last_status="$current_status"
        fi

        if [[ "$dvn_verified" == "true" ]]; then
            if $JSON_OUTPUT; then
                echo "{\"status\":\"verified\",\"message_id\":\"$GUID\",\"dest_tx\":\"$tx_hash_dest\",\"elapsed\":$elapsed}"
            else
                echo ""
                echo "Message verified on destination chain"
                [[ -n "$GUID" ]] && echo "Message ID: $GUID"
                [[ -n "$tx_hash_dest" && "$tx_hash_dest" != "null" ]] && echo "Dest TX: $tx_hash_dest"
            fi
            exit 0
        fi

        sleep 2
    done
}

cmd_watch_chainlink_ccv() {
    if $DRY_RUN; then
        echo "# Poll operators for CCV message status"
        echo "curl -s http://localhost:3001/debug/v1/messages?limit=50"
        return 0
    fi

    load_watch_target_from_cache

    if ! $JSON_OUTPUT; then
        echo "═══════════════════════════════════════════════════════════════════"
        echo "Watching Chainlink CCV message (timeout: ${TIMEOUT}s)"
        echo "═══════════════════════════════════════════════════════════════════"
        echo ""
    fi

    local start_time last_status
    start_time=$(date +%s)
    last_status=""

    while true; do
        local elapsed=$(( $(date +%s) - start_time ))
        if [[ $elapsed -ge $TIMEOUT ]]; then
            $JSON_OUTPUT && echo "{\"status\":\"timeout\",\"elapsed\":$elapsed}" || echo "Timeout after ${TIMEOUT}s"
            exit 1
        fi

        local best_status="" best_submission="" tx_hash_dest="" found_guid=""

        for i in 1 2 3; do
            local port=$((3000 + i))
            local response
            response=$(query_operator "$port" "$GUID" "$TX_HASH")

            if [[ "$response" != "{}" && -n "$response" && "$response" != "null" ]]; then
                if [[ -z "$GUID" || "$GUID" == "null" ]]; then
                    found_guid=$(echo "$response" | jq -r '.metadata.message_id // empty' 2>/dev/null || true)
                    [[ -n "$found_guid" && "$found_guid" != "null" ]] && GUID="$found_guid"
                fi

                local status submission_state submission_tx
                status=$(echo "$response" | jq -r '.status // "?"' 2>/dev/null || echo "?")
                submission_state=$(echo "$response" | jq -r '.submission.state // "Pending"' 2>/dev/null || echo "Pending")
                submission_tx=$(echo "$response" | jq -r '.submission.tx_hash // empty' 2>/dev/null || true)

                case $status in
                    Signed)
                        best_status="Signed"
                        best_submission="$submission_state"
                        tx_hash_dest="$submission_tx"
                        ;;
                    Processing) [[ "$best_status" != "Signed" ]] && best_status="Processing" ;;
                    Pending) [[ -z "$best_status" ]] && best_status="Pending" ;;
                    *) [[ -z "$best_status" ]] && best_status="$status" ;;
                esac
            fi
        done

        local current_status="${best_status}:${best_submission}"
        if [[ "$current_status" != "$last_status" ]] && ! $JSON_OUTPUT; then
            local timestamp prev_status prev_submission
            timestamp=$(date +%H:%M:%S)
            IFS=':' read -r prev_status prev_submission <<< "$last_status"

            if [[ -n "$GUID" && "$last_status" == "" ]]; then
                echo "[$timestamp] Message ID: $GUID"
            fi
            [[ "$best_status" != "$prev_status" && -n "$best_status" ]] && echo "[$timestamp] $(format_status "$best_status")"
            if [[ "$best_submission" != "$prev_submission" && -n "$best_submission" && "$best_submission" != "Pending" ]]; then
                echo "[$timestamp] $(format_relayer_status "$best_submission" "$tx_hash_dest")"
            fi

            last_status="$current_status"
        fi

        # For CCV mock flow, success is when payload is signed by operators.
        if [[ "$best_status" == "Signed" ]]; then
            if $JSON_OUTPUT; then
                echo "{\"status\":\"signed\",\"message_id\":\"$GUID\",\"submission_state\":\"$best_submission\",\"dest_tx\":\"$tx_hash_dest\",\"elapsed\":$elapsed}"
            else
                echo ""
                echo "CCV payload signed by operators"
                [[ -n "$GUID" ]] && echo "Message ID: $GUID"
                echo "Submission state: ${best_submission:-Pending}"
                [[ -n "$tx_hash_dest" && "$tx_hash_dest" != "null" ]] && echo "Dest TX: $tx_hash_dest"
                echo "Note: full OffRamp execution requires Chainlink CCIP infra"
            fi
            exit 0
        fi

        sleep 2
    done
}

cmd_watch() {
    case "$ACTIVE_PROVIDER" in
        layerzero) cmd_watch_layerzero ;;
        chainlink_ccv) cmd_watch_chainlink_ccv ;;
        *) die "unsupported active provider: $ACTIVE_PROVIDER" ;;
    esac
}

cmd_e2e() {
    if ! $JSON_OUTPUT; then
        echo "═══════════════════════════════════════════════════════════════════"
        if [[ "$ACTIVE_PROVIDER" == "layerzero" ]]; then
            echo "E2E Test (LayerZero): send and verify DVN submission"
        else
            echo "E2E Test (Chainlink CCV): inject event and wait for signed payload"
        fi
        echo "═══════════════════════════════════════════════════════════════════"
        echo ""
    fi

    cmd_send
    echo ""
    cmd_watch
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            send|status|watch|e2e)
                if [[ -z "$COMMAND" ]]; then
                    COMMAND="$1"
                else
                    if [[ "$COMMAND" == "send" ]]; then
                        MESSAGE="$1"
                    else
                        GUID="$1"
                    fi
                fi
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --json)
                JSON_OUTPUT=true
                shift
                ;;
            --timeout)
                TIMEOUT="$2"
                shift 2
                ;;
            -m|--message)
                MESSAGE="$2"
                shift 2
                ;;
            -g|--guid)
                GUID="$2"
                shift 2
                ;;
            -t|--tx)
                TX_HASH="$2"
                shift 2
                ;;
            *)
                if [[ -z "$COMMAND" ]]; then
                    die "unknown command: $1"
                fi
                if [[ "$COMMAND" == "send" ]]; then
                    MESSAGE="$1"
                else
                    GUID="$1"
                fi
                shift
                ;;
        esac
    done
}

main() {
    COMMAND=""

    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    parse_args "$@"

    if [[ -z "$COMMAND" ]]; then
        show_help
        exit 0
    fi

    load_runtime_context

    case "$COMMAND" in
        send) cmd_send ;;
        status) cmd_status ;;
        watch) cmd_watch ;;
        e2e) cmd_e2e ;;
        *) die "unknown command: $COMMAND" ;;
    esac
}

main "$@"
