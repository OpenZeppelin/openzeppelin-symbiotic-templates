#!/usr/bin/env bash
# Unified devnet message testing tool
#
# Provider selection is loaded from the environment JSON (activeProvider).
# Supported providers:
#   - layerzero: real TestOApp send + destination target verification watch
#   - chainlink_ccv: on-chain CCIPMessageSent send + destination confirmation watch

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Load .env before common.sh so SOURCE_RPC_URL / DEST_RPC_URL are available
# when common.sh derives SOURCE_RPC / DEST_RPC.
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$PROJECT_ROOT/.env"
    set +a
fi

source "$SCRIPT_DIR/lib/common.sh"

# Global flags
VERBOSE=false
DRY_RUN=false
JSON_OUTPUT=false
TIMEOUT=120
MESSAGE="hello"
GUID=""
TX_HASH=""
ACTIVE_PROVIDER=""

CCV_EVENT_SIGNATURE="CCIPMessageSent(uint64,address,bytes32,address,uint256,bytes,(address,uint32,uint32,uint256,bytes)[],bytes[])"
CCV_EXECUTED_EVENT_SIGNATURE="MessageExecuted(bytes32,uint256,uint256)"
CCV_VERSION_TAG="${CCV_VERSION_TAG:-0x1a75bd93}"

# Provider-specific extensions.
# shellcheck disable=SC1091
source "$SCRIPT_DIR/providers/layerzero/msg.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/providers/chainlink_ccv/msg.sh"

show_help() {
    cat <<'USAGE'
msg - Devnet message testing tool

USAGE:
    msg <command> [options]

COMMANDS:
    send      Send a test message
    status    One-shot status check across all operators
    watch     Poll operators until message is confirmed on destination
    e2e       Combined send + watch

OPTIONS:
    -m, --message <text>   Message content (default: "hello")
    -g, --guid <id>        Message ID to check/watch
    -t, --tx <hash>        Source TX hash to find message
    --timeout <seconds>    Max wait time for watch/e2e (default: 120)
    -v, --verbose          Show streaming logs
    --dry-run              Print commands without executing
    --json                 Machine-readable output
    -h, --help             Show this help

PROVIDER:
    Provider is loaded from the environment JSON -> activeProvider.
    This script intentionally does not accept --provider.

EXAMPLES:
    msg send
    msg send -m "hello world"
    msg watch --timeout 180
    msg e2e -v
USAGE
}

load_runtime_context() {
    ACTIVE_PROVIDER="$(get_active_provider)"

    case "$ACTIVE_PROVIDER" in
        layerzero|chainlink_ccv)
            ;;
        *)
            die "unsupported active_provider '$ACTIVE_PROVIDER' in $(env_config_file)"
            ;;
    esac

    if [[ "$ACTIVE_PROVIDER" == "layerzero" ]]; then
        DEST_EID="$(get_layerzero_dest_eid)"
    fi
}

load_watch_target_from_cache() {
    if [[ -n "$GUID" || -n "$TX_HASH" ]]; then
        return 0
    fi

    if [[ ! -f "$CACHE_FILE" ]]; then
        die "no message to watch. Run 'msg send' first or specify --guid/--tx"
    fi

    GUID="$(jq -r 'if .guid == null then "" else .guid end' "$CACHE_FILE" 2>/dev/null || true)"
    TX_HASH="$(jq -r '.tx_hash // empty' "$CACHE_FILE" 2>/dev/null || true)"

    if [[ -z "$GUID" && -z "$TX_HASH" ]]; then
        die "no message to watch. Run 'msg send' first or specify --guid/--tx"
    fi

    if ! $JSON_OUTPUT; then
        local msg
        msg="$(jq -r '.message // empty' "$CACHE_FILE" 2>/dev/null || true)"
        [[ -n "$msg" ]] && echo "Watching last message: \"$msg\""
        [[ -n "$TX_HASH" ]] && echo "TX: $TX_HASH"
        [[ -n "$GUID" ]] && echo "Message ID: $GUID"
        echo ""
    fi
}

ensure_provider_deployed() {
    if ! provider_has_deploy_state "$ACTIVE_PROVIDER"; then
        if is_local; then
            die "Contracts not deployed for provider '$ACTIVE_PROVIDER'. Run 'make start' first."
        fi
        die "Contracts not deployed for provider '$ACTIVE_PROVIDER'. Run 'make deploy ENV=$ENV' first."
    fi
}

cmd_send() {
    case "$ACTIVE_PROVIDER" in
        layerzero) cmd_send_layerzero ;;
        chainlink_ccv) cmd_send_chainlink_ccv ;;
        *) die "unsupported active provider: $ACTIVE_PROVIDER" ;;
    esac
}

cmd_status() {
    if [[ -z "$GUID" && -z "$TX_HASH" && -f "$CACHE_FILE" ]]; then
        GUID=$(jq -r 'if .guid == null then "" else .guid end' "$CACHE_FILE" 2>/dev/null || true)
        TX_HASH=$(jq -r '.tx_hash // empty' "$CACHE_FILE" 2>/dev/null || true)
        if ! $JSON_OUTPUT; then
            local msg
            msg=$(jq -r '.message // empty' "$CACHE_FILE" 2>/dev/null || true)
            [[ -n "$msg" ]] && echo "Last message: \"$msg\""
            [[ -n "$TX_HASH" ]] && echo "TX: $TX_HASH"
            echo ""
        fi
    fi

    if $DRY_RUN; then
        echo "# Query all operators"
        for port in "${OPERATOR_PORTS[@]}"; do
            echo "curl -s http://localhost:$port/debug/v1/messages?limit=50"
        done
        return 0
    fi

    if $JSON_OUTPUT; then
        local results="[]"
        for i in 1 2 3; do
            local port=$((3000 + i))
            local response
            response=$(query_operator "$port" "$GUID" "$TX_HASH")
            if [[ "$response" != "{}" && -n "$response" && "$response" != "null" ]]; then
                results=$(echo "$results" | jq --argjson data "$response" --argjson operator "$i" '. + [{operator:$operator,data:$data}]')
            fi
        done
        echo "$results"
        return 0
    fi

    echo "Provider: $ACTIVE_PROVIDER"
    echo "Operator Status"
    echo "═══════════════════════════════════════════════════════════════════"

    for i in 1 2 3; do
        local port=$((3000 + i))
        local response
        response=$(query_operator "$port" "$GUID" "$TX_HASH")

        echo ""
        echo "operator-$i (port $port):"

        if [[ -z "$response" || "$response" == "{}" || "$response" == "null" ]]; then
            echo "  Status: No message found"
            continue
        fi

        local msg_id status src_chain dst_chain sub_state sub_tx sub_err
        msg_id=$(echo "$response" | jq -r '.metadata.message_id // "?"' 2>/dev/null)
        status=$(echo "$response" | jq -r '.status // "?"' 2>/dev/null)
        src_chain=$(echo "$response" | jq -r '.metadata.source_chain // "?"' 2>/dev/null)
        dst_chain=$(echo "$response" | jq -r '.metadata.destination_chain // "?"' 2>/dev/null)
        sub_state=$(echo "$response" | jq -r '.submission.state // "Pending"' 2>/dev/null)
        sub_tx=$(echo "$response" | jq -r '.submission.tx_hash // empty' 2>/dev/null)
        sub_err=$(echo "$response" | jq -r '.submission.last_error // empty' 2>/dev/null)

        echo "  Message ID: ${msg_id:0:20}..."
        echo "  Route: $src_chain -> $dst_chain"
        echo "  Status: $status"
        echo "  Submission: $sub_state"
        [[ -n "$sub_tx" && "$sub_tx" != "null" ]] && echo "  Dest TX: $sub_tx"
        [[ "$sub_state" == "Failed" && -n "$sub_err" ]] && echo "  Error: $sub_err"
    done

    echo ""
    echo "═══════════════════════════════════════════════════════════════════"
    echo "Pending Merkle Roots"
    echo "═══════════════════════════════════════════════════════════════════"

    local pending_count
    pending_count=$(curl -sf "http://localhost:3001/debug/v1/pending" 2>/dev/null | jq 'length' 2>/dev/null || echo "0")
    if [[ "$pending_count" == "0" || "$pending_count" == "null" ]]; then
        echo "None (all signatures collected)"
    else
        echo "$pending_count pending root(s) awaiting signatures"
    fi
}

cmd_watch() {
    case "$ACTIVE_PROVIDER" in
        layerzero) cmd_watch_layerzero ;;
        chainlink_ccv) cmd_watch_chainlink_ccv ;;
        *) die "unsupported active provider: $ACTIVE_PROVIDER" ;;
    esac
}

cmd_e2e() {
    if ! $JSON_OUTPUT; then
        echo "═══════════════════════════════════════════════════════════════════"
        if [[ "$ACTIVE_PROVIDER" == "layerzero" ]]; then
            echo "E2E Test (LayerZero): send and verify destination target submission"
        else
            echo "E2E Test (Chainlink CCV): send on-chain event and wait for destination confirmation"
        fi
        echo "═══════════════════════════════════════════════════════════════════"
        echo ""
    fi

    cmd_send
    echo ""
    cmd_watch
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            send|status|watch|e2e)
                if [[ -z "$COMMAND" ]]; then
                    COMMAND="$1"
                else
                    if [[ "$COMMAND" == "send" ]]; then
                        MESSAGE="$1"
                    else
                        GUID="$1"
                    fi
                fi
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --json)
                JSON_OUTPUT=true
                shift
                ;;
            --timeout)
                TIMEOUT="$2"
                shift 2
                ;;
            -m|--message)
                MESSAGE="$2"
                shift 2
                ;;
            -g|--guid)
                GUID="$2"
                shift 2
                ;;
            -t|--tx)
                TX_HASH="$2"
                shift 2
                ;;
            *)
                if [[ -z "$COMMAND" ]]; then
                    die "unknown command: $1"
                fi
                if [[ "$COMMAND" == "send" ]]; then
                    MESSAGE="$1"
                else
                    GUID="$1"
                fi
                shift
                ;;
        esac
    done
}

main() {
    COMMAND=""

    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    parse_args "$@"

    if [[ -z "$COMMAND" ]]; then
        show_help
        exit 0
    fi

    load_runtime_context

    case "$COMMAND" in
        send)
            ensure_provider_deployed
            cmd_send
            ;;
        status) cmd_status ;;
        watch)
            ensure_provider_deployed
            cmd_watch
            ;;
        e2e)
            ensure_provider_deployed
            cmd_e2e
            ;;
        *) die "unknown command: $COMMAND" ;;
    esac
}

main "$@"
