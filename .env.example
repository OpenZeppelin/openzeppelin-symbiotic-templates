# Operator Environment Configuration
# Copy to .env and customize, or run 'make setup' to generate automatically.

# ═══════════════════════════════════════════════════════════════════════════════
# General
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info

# Deployer private key (funds operators, deploys contracts)
# Default: Anvil account 0 (local development only — has unlimited ETH)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ═══════════════════════════════════════════════════════════════════════════════
# Relay Timing
# ═══════════════════════════════════════════════════════════════════════════════
# Production defaults (28800s / 86400s) are too slow for dev/testnet.
# These control how long vault deposits take to activate and how often
# the relay driver advances epochs.

# Driver epoch length in seconds (default: 28800 = 8 hours)
EPOCH_DURATION=60
# Vault epoch / deposit activation time in seconds (default: 86400 = 1 day)
SLASHING_WINDOW=60

# ═══════════════════════════════════════════════════════════════════════════════
# Operator Private Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Each operator has its own EVM private key, also used as BLS key seed.
# Run 'make setup' to generate random keys, or set your own.

OPERATOR_COUNT=3
# OPERATOR_1_PRIVATE_KEY=0x...
# OPERATOR_2_PRIVATE_KEY=0x...
# OPERATOR_3_PRIVATE_KEY=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# OZ Monitor (event watching)
# ═══════════════════════════════════════════════════════════════════════════════

WEBHOOK_URL=http://operator:3000/webhook/events
WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
METRICS_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# OZ Relayer (transaction submission)
# ═══════════════════════════════════════════════════════════════════════════════

OZ_RELAYER_API_KEY=test-api-key-that-is-at-least-32-chars-long
OZ_RELAYER_WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
KEYSTORE_PASSPHRASE=test-passphrase

# Signer addresses (auto-derived from OPERATOR_N_PRIVATE_KEY by 'make setup')
# SIGNER_1_ADDRESS=0x...
# SIGNER_2_ADDRESS=0x...
# SIGNER_3_ADDRESS=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# Testnet / External Network Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Uncomment and configure for non-local (testnet) deployments.
# Also update config/root.config.json to use testnet chain IDs.

# SOURCE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# DEST_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# PRIVATE_KEY=0x_your_funded_deployer_key

# Testnet timing (longer epochs for stability)
# EPOCH_DURATION=300
# SLASHING_WINDOW=300
# EPOCH_START_DELAY=300

# ═══════════════════════════════════════════════════════════════════════════════
# Advanced: Sidecar Key Override (optional)
# ═══════════════════════════════════════════════════════════════════════════════
# Override auto-derived sidecar secret keys. Only needed for production setups
# with separate key management. Leave empty to auto-derive from OPERATOR_N_PRIVATE_KEY.
# SIDECAR_1_SECRET_KEYS=
# SIDECAR_2_SECRET_KEYS=
# SIDECAR_3_SECRET_KEYS=
