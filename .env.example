# Operator Environment Configuration
# Copy to .env and fill in values, or run 'make setup' to generate automatically.
#
# All non-secret config (chain IDs, timing, addresses) lives in
# config/environments/{local,testnet,mainnet}.json — NOT here.

# ═══════════════════════════════════════════════════════════════════════════════
# Deployer Key
# ═══════════════════════════════════════════════════════════════════════════════
# Funds operators and deploys contracts.
# Default: Anvil account 0 (local development only — has unlimited ETH)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ═══════════════════════════════════════════════════════════════════════════════
# Operator Private Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Each operator has its own EVM private key, also used as BLS key seed.
# Run 'make setup' to generate random keys, or set your own.
# OPERATOR_1_PRIVATE_KEY=0x...
# OPERATOR_2_PRIVATE_KEY=0x...
# OPERATOR_3_PRIVATE_KEY=0x...

# ═══════════════════════════════════════════════════════════════════════════════
# RPC URLs (testnet/mainnet only — local uses Docker-internal anvil URLs)
# ═══════════════════════════════════════════════════════════════════════════════
# SOURCE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# DEST_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ═══════════════════════════════════════════════════════════════════════════════
# Service Secrets
# ═══════════════════════════════════════════════════════════════════════════════
WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
OZ_RELAYER_API_KEY=test-api-key-that-is-at-least-32-chars-long
OZ_RELAYER_WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
KEYSTORE_PASSPHRASE=test-passphrase
