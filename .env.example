# Operator Environment Configuration
#
# Copy to:
#   .env.local      for ENV=local   (anvil chains, no real secrets needed)
#   .env.testnet    for ENV=testnet (Base Sepolia source, Sepolia destination)
#   .env.mainnet    for ENV=mainnet
#
# xtask reads `.env.<env>`, not `.env`. Plain `.env` is only loaded by
# docker-compose's auto-load when compose is run outside xtask.
#
# All non-secret config (chain IDs, timing, addresses, signer wiring) lives in
# config/environments/{local,testnet,mainnet}.json — NOT here.

# ═══════════════════════════════════════════════════════════════════════════════
# General
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
# Service secrets (all envs)
# ═══════════════════════════════════════════════════════════════════════════════

WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
OZ_RELAYER_API_KEY=test-api-key-that-is-at-least-32-chars-long
OZ_RELAYER_WEBHOOK_SECRET=test-webhook-secret-32-chars-minimum
# Used by OZ Relayer container to decrypt relayer keystores at runtime.
KEYSTORE_PASSPHRASE=test-passphrase
METRICS_ENABLED=false

# Chainlink CCV verifier attestation API base URLs (comma-separated).
# Required for non-local CCV deployments. ENV=local-ccv uses the Docker-network
# operator URLs http://operator-{1,2,3}:3000 when this is unset.
# CCV_STORAGE_LOCATION_URIS=https://operator.example

# Local CCV address determinism is pinned by:
# - ccv-factory-deployer signer: Anvil account 9 (nonce 0)
# - resolver salt: keccak256("symbiotic.ccv.versioned-verifier-resolver.v1")
# - @chainlink/contracts-ccip published resolver bytecode version: 2.0.0

# ═══════════════════════════════════════════════════════════════════════════════
# RPC URLs (testnet / mainnet only)
# ═══════════════════════════════════════════════════════════════════════════════
# Testnet: source = Base Sepolia, destination = Sepolia.
#
# SOURCE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
# DEST_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>
#
# Fork tests (make test-fork) also need the real RMN contract address on each
# chain — SymbioticVerifier's constructor requires it.
#
# SOURCE_CCIP_RMN_ADDRESS=0x<rmn-on-base-sepolia>
# DEST_CCIP_RMN_ADDRESS=0x<rmn-on-sepolia>

# ═══════════════════════════════════════════════════════════════════════════════
# Keystore passphrases (testnet / mainnet only)
# ═══════════════════════════════════════════════════════════════════════════════
# For local, signer keys are derived from anvil's well-known mnemonic — no
# keystores or passphrases needed.
#
# For testnet/mainnet, generate keystores first (each prompts for a passphrase).
# Pass `--env <env>` so keys land under `config/keys/<env>/`, where the matching
# env config in `config/environments/<env>.json` looks for them:
#
#   cargo xtask --env testnet generate-signer --name deployer \
#       --name operator-1 --name operator-2 --name operator-3
#   cargo xtask --env testnet generate-signer --name signer-1 --name signer-2 --name signer-3
#
# (Swap `testnet` for `mainnet` to populate `config/keys/mainnet/`.)
#
# Then set the matching env var to the passphrase you used:
#
# DEPLOYER_PASSPHRASE=
# OPERATOR_1_PASSPHRASE=
# OPERATOR_2_PASSPHRASE=
# OPERATOR_3_PASSPHRASE=
#
# CCV deployments additionally need a reserved factory-deployer key (must stay at
# nonce 0 on every target chain — it anchors the resolver's CREATE2 address parity):
#
#   cargo xtask --env testnet-ccv generate-signer --name ccv-factory-deployer
#
# CCV_FACTORY_DEPLOYER_PASSPHRASE=

# ═══════════════════════════════════════════════════════════════════════════════
# Optional overrides (advanced)
# ═══════════════════════════════════════════════════════════════════════════════
# Override the key used for relay genesis (defaults to deployer signer key)
# GENESIS_PRIVATE_KEY=0x...
